{
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": [
          "effect",
          "@effect/*"
        ],
        "diagnosticSeverity": {
          "importFromBarrel": "error"
        }
      }
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "importsNotUsedAsValues": "remove",
    "exactOptionalPropertyTypes": false,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "module": "ESNext"
  },
  "exclude": [
    "coverage",
    "dist",
    "node_modules"
  ],
  "extends": [
    "@tsconfig/strictest/tsconfig"
  ]
}