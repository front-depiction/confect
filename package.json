{
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "bun -r --filter='@rjdellecese/*' build",
		"build:confect": "bun --filter @rjdellecese/confect build",
		"build:docs": "bun --filter @rjdellecese/docs build",
		"build:example": "bun --filter @rjdellecese/example build",
		"dev": "bun -r --parallel dev",
		"dev:confect": "bun --filter @rjdellecese/confect dev",
		"dev:docs": "bun --filter @rjdellecese/docs dev",
		"dev:example": "bun --filter @rjdellecese/example dev",
		"typecheck": "bun -r typecheck",
		"lint": "bun -r lint",
		"fix": "bun -r fix",
		"test": "bun -r test",
		"release": "bun build:confect && changeset publish",
		"clean": "bun -r clean && rm -rf node_modules"
	},
	"keywords": [
		"effect",
		"convex",
		"monorepo"
	],
	"license": "ISC",
	"devDependencies": {
		"@changesets/cli": "2.29.5",
		"@changesets/config": "3.1.1",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=20",
		"bun": ">=10"
	}
}
